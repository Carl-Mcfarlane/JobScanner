# MongoDB Atlas connection string (see README for how to create a free cluster)
MONGODB_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/job-finder?retryWrites=true&w=majority

# Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Where the daily digest gets sent. With Resend's sandbox sender
# (onboarding@resend.dev) this MUST be the email address on your Resend account.
DIGEST_TO_EMAIL=carltmcfarlane@gmail.com

# Shared secret Vercel Cron sends as "Authorization: Bearer <value>".
# Set the same value in Vercel project env vars. Prevents random internet
# traffic from triggering your scrape/email endpoint.
CRON_SECRET=change-me-to-a-long-random-string

# Set to "true" to allow a manual re-run to send even if today's digest
# already went out. Only used for local/manual testing.
FORCE_DIGEST=false
