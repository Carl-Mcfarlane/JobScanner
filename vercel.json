{
  "regions": ["syd1"],
  "crons": [
    { "path": "/api/cron/digest", "schedule": "30 3 * * *" }
  ],
  "functions": {
    "api/cron/digest.js": { "maxDuration": 300 }
  },
  "rewrites": [
    { "source": "/", "destination": "/api/home" },
    { "source": "/saved", "destination": "/api/saved" },
    { "source": "/removed", "destination": "/api/removed" }
  ]
}
